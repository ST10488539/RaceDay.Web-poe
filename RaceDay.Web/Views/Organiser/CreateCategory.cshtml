@model RaceDay.Web.Models.CategoryFormViewModel
@{
    ViewData["Title"] = "Add Category";
}

<h2>Add Category</h2>

<div asp-validation-summary="All" class="text-danger"></div>

<form asp-action="CreateCategory" method="post">
    <input type="hidden" asp-for="EventID" />

    <div class="mb-3">
        <label asp-for="CategoryName" class="form-label"></label>
        <input asp-for="CategoryName" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Distance" class="form-label">Distance (km)</label>
        <input asp-for="Distance" class="form-control" type="number" step="0.01" />
    </div>

    <div class="mb-3">
        <label asp-for="MinAge" class="form-label"></label>
        <input asp-for="MinAge" class="form-control" type="number" />
    </div>

    <div class="mb-3">
        <label asp-for="MaxAge" class="form-label">Max Age (optional)</label>
        <input asp-for="MaxAge" class="form-control" type="number" />
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control"></textarea>
    </div>

    <button type="submit" class="btn btn-primary">Add Category</button>
</form>