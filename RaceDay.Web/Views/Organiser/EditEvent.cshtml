@model RaceDay.Web.Models.EventFormViewModel
@{
    ViewData["Title"] = "Edit Event";
}

<h2>Edit Event</h2>

<div asp-validation-summary="All" class="text-danger"></div>

<form asp-action="EditEvent" asp-route-id="@Model.EventID" method="post">
    <div class="mb-3">
        <label asp-for="EventName" class="form-label"></label>
        <input asp-for="EventName" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="EventDate" class="form-label"></label>
        <input asp-for="EventDate" class="form-control" type="date" />
    </div>

    <div class="mb-3">
        <label asp-for="Location" class="form-label"></label>
        <input asp-for="Location" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control"></textarea>
    </div>

    <div class="mb-3">
        <label asp-for="Distance" class="form-label">Distance (km)</label>
        <input asp-for="Distance" class="form-control" type="number" step="0.01" />
    </div>

    <div class="mb-3">
        <label asp-for="EventType" class="form-label"></label>
        <select asp-for="EventType" class="form-select">
            <option value="RUN">Run</option>
            <option value="WALK">Walk</option>
            <option value="CYCLE">Cycle</option>
        </select>
    </div>

    <button type="submit" class="btn btn-primary">Save Changes</button>
</form>

<hr />
<a asp-action="Categories" asp-route-eventId="@Model.EventID" class="btn btn-outline-secondary">Manage Categories</a>
<a asp-action="Enrolments" asp-route-eventId="@Model.EventID" class="btn btn-outline-secondary">View Enrolments</a>
<a asp-action="Results" asp-route-eventId="@Model.EventID" class="btn btn-outline-secondary">Enter Results</a>