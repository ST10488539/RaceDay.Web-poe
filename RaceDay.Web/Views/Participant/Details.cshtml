@model RaceDay.Web.Models.EventViewModel
@{
    ViewData["Title"] = Model.EventName;
    var categories = ViewBag.Categories as List<RaceDay.Web.Models.CategoryViewModel>;
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<h2>@Model.EventName</h2>
<p>
    @Model.EventDate.ToString("dd MMM yyyy") &middot; @Model.Location<br />
    @Model.Distance km &middot; @Model.EventType<br />
    Organised by @Model.OrganiserName
</p>
<p>@Model.Description</p>

<h4>Choose a Category to Enrol</h4>

@if (categories == null || !categories.Any())
{
    <p>No categories available yet for this event.</p>
}
else
{
    <form asp-action="Enrol" method="post">
        <input type="hidden" name="eventId" value="@Model.EventID" />

        <div class="mb-3">
            <select name="categoryId" class="form-select" required>
                <option value="">-- Select a category --</option>
                @foreach (var cat in categories)
                {
                    <option value="@cat.CategoryID">
                        @cat.CategoryName (@cat.Distance km, age @cat.MinAge@(cat.MaxAge != null ? $"-{cat.MaxAge}" : "+"))
                    </option>
                }
            </select>
        </div>

        <button type="submit" class="btn btn-primary">Enrol</button>
    </form>
}

<a asp-action="Index" class="btn btn-link mt-3">Back to Events</a>