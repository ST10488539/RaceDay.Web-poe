@model RaceDay.Web.Models.ProfileViewModel
@{
    ViewData["Title"] = "My Profile";
}

<h2>My Profile</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (!string.IsNullOrEmpty(Model.ProfilePictureURL))
{
    <img src="@Model.ProfilePictureURL" alt="Profile picture" class="rounded-circle mb-3"
         style="width: 120px; height: 120px; object-fit: cover;" />
}
else
{
    <p class="text-muted">No profile picture yet.</p>
}

<div asp-validation-summary="All" class="text-danger"></div>

<form asp-action="Profile" method="post">
    <input type="hidden" asp-for="UserID" />
    <input type="hidden" asp-for="Email" />
    <input type="hidden" asp-for="Role" />
    <input type="hidden" asp-for="DateCreated" />

    <div class="mb-3">
        <label asp-for="FirstName" class="form-label"></label>
        <input asp-for="FirstName" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="LastName" class="form-label"></label>
        <input asp-for="LastName" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Email</label>
        <input value="@Model.Email" class="form-control" disabled />
    </div>

    <div class="mb-3">
        <label asp-for="Phone" class="form-label"></label>
        <input asp-for="Phone" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="DateOfBirth" class="form-label"></label>
        <input asp-for="DateOfBirth" class="form-control" type="date" />
    </div>

    <div class="mb-3">
        <label asp-for="Gender" class="form-label"></label>
        <select asp-for="Gender" class="form-select">
            <option value="">-- Select --</option>
            <option value="MALE">Male</option>
            <option value="FEMALE">Female</option>
            <option value="OTHER">Other</option>
        </select>
    </div>

    <div class="mb-3">
        <label asp-for="EmergencyContact" class="form-label"></label>
        <input asp-for="EmergencyContact" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="MedicalNotes" class="form-label"></label>
        <textarea asp-for="MedicalNotes" class="form-control"></textarea>
    </div>

    <button type="submit" class="btn btn-primary">Save Changes</button>
</form>

<hr />

<h4>Profile picture</h4>

<form asp-action="UploadProfilePicture" method="post" enctype="multipart/form-data">
    <div class="mb-3">
        <label for="pictureFile" class="form-label">Choose a JPG, PNG or WEBP image (max 5 MB)</label>
        <input type="file" name="pictureFile" id="pictureFile" class="form-control" accept=".jpg,.jpeg,.png,.webp" required />
    </div>
    <button type="submit" class="btn btn-outline-primary">Upload Picture</button>
</form>