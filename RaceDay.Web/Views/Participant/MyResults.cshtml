@model List<RaceDay.Web.Models.ResultViewModel>
@{
    ViewData["Title"] = "My Results";
}

<h2>My Results</h2>

@if (!Model.Any())
{
    <p>You don't have any results yet.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Event</th>
                <th>Date</th>
                <th>Category</th>
                <th>Finish Time</th>
                <th>Overall Position</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in Model)
            {
                <tr>
                    <td>@r.EventName</td>
                    <td>@r.EventDate.ToString("dd MMM yyyy")</td>
                    <td>@r.CategoryName</td>
                    <td>@r.FinishTime.ToString(@"hh\:mm\:ss")</td>
                    <td>@r.OverallPosition</td>
                </tr>
            }
        </tbody>
    </table>
}